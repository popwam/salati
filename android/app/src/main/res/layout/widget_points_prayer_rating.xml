<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/salati_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_modern_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="النقاط"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/points_widget_score"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="0"
        android:textColor="@color/widget_primary"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/points_widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="رصيدك اليوم"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp" />

</LinearLayout>
